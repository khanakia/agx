# Normalize line endings — keep LF in the repo regardless of OS.
* text=auto eol=lf

# Binary assets (don't diff/normalize).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Generated/vendored — collapse in diffs and exclude from language stats.
*.lock linguist-generated=true
vendor/** linguist-vendored
dist/** linguist-generated=true
# >>> lore-sync >>>
.lore/data/**/*.json text eol=lf merge=lore linguist-generated=true
.lore/data/*.json text eol=lf merge=lore linguist-generated=true
.lore/LORE.md text eol=lf merge=lore-keep-ours linguist-generated=true
# <<< lore-sync <<<
